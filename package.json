{
  "name": "cruzadas-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run generate:vocabulary && npm run generate:registry",
    "build": "vite build",
    "prebuild": "npm run validate:release && npm run generate:vocabulary && npm run generate:registry",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-challenges.ts",
    "validate:release": "tsx scripts/validate-challenges.ts --release",
    "generate:registry": "tsx scripts/generate-challenge-registry.ts",
    "generate:vocabulary": "tsx scripts/generate-vocabulary.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:rebuild": "docker compose build --no-cache && docker compose up -d"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "lucide-react": "^1.16.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "~4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.0.10",
    "@types/react-dom": "~19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "~10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "tailwindcss": "~4.3.0",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.26.0",
    "vite": "~8.1.0",
    "vitest": "~5.0.0",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.131.1"
  }
}
