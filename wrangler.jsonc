{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cruzadas-online",
  "compatibility_date": "2026-09-11",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cruzadas-telemetry-d1",
      // database_id is obtained upon real provisioning via `wrangler d1 create cruzadas-telemetry-d1`
      "database_id": "cruzadas-telemetry-d1-placeholder",
      "migrations_dir": "worker/migrations"
    }
  ]
}
